---
const { title = "Maraliza" } = Astro.props;
---
<html lang="nl">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title></head>
  <body>
    <header><a href="/">maraliza.</a><nav><a href="/">Home</a><a href="/over">Over mij</a><a href="/blog/klein-beginnen">Verhalen</a></nav></header>
    <main><slot /></main>
    <footer>Met aandacht geschreven. © Maraliza</footer>
  </body>
</html>
<style is:global>
  body { margin: 0; background: #f7f5ef; color: #28382f; font-family: Georgia, serif; }
  header, footer { padding: 28px 7%; display: flex; justify-content: space-between; border-bottom: 1px solid #dddcd1; }
  header > a { font-size: 26px; font-weight: bold; }
  a { color: inherit; text-decoration: none; }
  nav { display: flex; gap: 24px; font: 14px system-ui; }
  main { max-width: 760px; margin: 90px auto; padding: 0 30px; }
  h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.06; font-weight: normal; }
  h2 { margin-top: 45px; font-weight: normal; font-size: 30px; }
  p { font-size: 19px; line-height: 1.8; }
  footer { font: 12px system-ui; border-top: 1px solid #dddcd1; border-bottom: none; }
</style>
